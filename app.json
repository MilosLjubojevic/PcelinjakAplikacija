{
  "expo": {
    "name": "PcelinjakAplikacija",
    "slug": "PcelinjakAplikacija",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pcelinjakaplikacija",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.PcelinjakAplikacija"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFB800",
          "dark": {
            "backgroundColor": "#8B6914"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
